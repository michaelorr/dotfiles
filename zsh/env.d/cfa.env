# zsh/env.d/cfa.env
#
export AWS_SESSION_TOKEN_TTL=24h
export AWS_ASSUME_ROLE_TTL=1h
export AWS_CHAINED_SESSION_TOKEN_TTL=24h
export AWS_FEDERATION_TOKEN_TTL=24h
export AWS_MIN_TTL=4h
export AWS_REGION=us-east-1

export CFLAGS="$CFLAGS -I/opt/homebrew/include"
export LDFLAGS="$LDFLAGS -L/opt/homebrew/lib"

asdf_update_java_home() {
  local java_path
  java_path="$(asdf which java)"
  if [[ -n "${java_path}" ]]; then
    export JAVA_HOME
    JAVA_HOME="$(dirname "$(dirname "${java_path:A}")")"
    export JDK_HOME=${JAVA_HOME}
  fi
}

autoload -U add-zsh-hook
add-zsh-hook chpwd asdf_update_java_home

# vim: ft=zsh:

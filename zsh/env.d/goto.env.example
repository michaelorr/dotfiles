# zsh/env.d/goto.env.example
#
# Copy to goto.env and edit for this machine.
#
# Requires enable_goto=true in bootstrap / local_overlay.
#
# GOTO_PROJECTS:          canonical project key -> display name
# GOTO_NICKS:             nickname -> canonical project key (at most one nick per project)
# GOTO_REPOS_<project>:   repo_name -> destination path (one assoc array per project)
# GOTO_REPOS:             project key -> name of that project's repo array

if [[ $- == *i* ]]; then
  typeset -gA GOTO_PROJECTS GOTO_NICKS GOTO_REPOS

  GOTO_PROJECTS=(
    [inventory]="Inventory Service"
    [checkout]="Checkout"
    [docsportal]="Docs Portal"
  )

  GOTO_NICKS=(
    [inv]=inventory
    [co]=checkout
    [docs]=docsportal
  )

  typeset -gA GOTO_REPOS_inventory
  GOTO_REPOS_inventory=(
    [api]=$SRC/inventory-api
    [worker]=$SRC/inventory-worker
    [notes]=$ETC/inventory
  )

  typeset -gA GOTO_REPOS_checkout
  GOTO_REPOS_checkout=(
    [api]=$SRC/checkout-api
    [ui]=$SRC/checkout-ui
    [atlas]=$SRC/checkout-atlas
  )

  typeset -gA GOTO_REPOS_docsportal
  GOTO_REPOS_docsportal=(
    [ui]=$SRC/docs-portal-ui
    [api]=$SRC/docs-portal-api
  )

  # Mapping of project key to repo array name
  GOTO_REPOS=(
    [inventory]=GOTO_REPOS_inventory
    [checkout]=GOTO_REPOS_checkout
    [docsportal]=GOTO_REPOS_docsportal
  )
fi

# vim: ft=zsh:

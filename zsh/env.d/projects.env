# zsh/env.d/projects.env

setopt cdable_vars

if [[ $- == *i* ]]; then
    typeset -A proj_arr
    proj_arr=( \
        [dot]=$DOT \
        [src]=$SRC \
        [etc]=/usr/local/etc \
        [rust]=$SRC/exercism/rust \
        [kilo]=$SRC/kilo \
        [bcui]=$SRC/rd-build-cost-ui \
        [bcapi]=$SRC/rd-build-cost-api)

    for k in "${(@k)proj_arr}"; do
        export $k=${proj_arr[$k]}
        hash -d $k=${proj_arr[$k]}
    done
fi

# vim: ft=zsh:

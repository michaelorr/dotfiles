#!/usr/bin/env zsh -i

# use fzf to select from already modified files in a repo

staged=0
[[ "${1}" == "--staged" ]] && staged=1

common_fzf_args=(
  -0 --multi
  --preview-window=right:75%
  --bind 'ctrl-up:preview-page-up,ctrl-down:preview-page-down'
  --layout=reverse
)

# The preview is generated by git diff (delta) but if the file is not yet tracked,
# git diff --no-index is used to compare the file against an empty file.
if (( staged )); then
  git diff --staged --name-only | \
    fzf "${common_fzf_args[@]}" \
      --preview-label=" shift+↑↓ scroll | ctrl+↑↓ page | ctrl-r restore " \
      --preview 'git diff --staged --color=always {} | delta --width=${FZF_PREVIEW_COLUMNS}' \
      --bind 'ctrl-r:execute-silent(git restore --staged {})+reload(git diff --staged --name-only)' \
    | xargs -o -r $EDITOR -p
else
  git ls-files --modified --other --exclude-standard | sort -u | \
    fzf "${common_fzf_args[@]}" \
      --preview-label=" shift+↑↓ scroll | ctrl+↑↓ page | ctrl-s stage " \
      --preview '
        if git ls-files --error-unmatch {} > /dev/null 2>&1; then
          git diff --color=always {} | delta --width=${FZF_PREVIEW_COLUMNS}
        else
          git diff --no-index --color=always /dev/null {} | delta --width=${FZF_PREVIEW_COLUMNS}
        fi
      ' \
      --bind 'ctrl-s:execute-silent(git add {})+reload(git ls-files --modified --other --exclude-standard | sort -u)' \
    | xargs -o -r $EDITOR -p
fi

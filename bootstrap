#!/usr/bin/env bash

set -euo pipefail

###
# Modify the following variables to customize the installation
###
export OS=darwin # `darwin`
export DOT=/usr/local/dot
zshrc=${DOT}/zsh/zshrc
export SRC=/usr/local/src
export TOOLS=/usr/local/etc
export DEFAULT_EMAIL="michael@orr.co"
export TMUX_ENABLED=true
export GOPATH=$SRC/go
export GO_INSTALL_PATH=/usr/local
export ARCH=arm64

install_google_cloud_sdk=false
install_tparse=false
install_brew_packages=false
update_brew_packages=false

# source ./local_overlay

export PATH+=":${GO_INSTALL_PATH}/go/bin"
export TPL_HEADER="###
# The following file was autogenerated from a template. Do not modify it directly.
###"

function start {
  echo ""
  echo ">>> $1 <<<"
  echo ""
}

function finished {
  echo "::: Done"
}

# Track generated files for diff review
declare -a generated_files=()

function register_generated {
  generated_files+=("$1")
}

function review_and_apply {
  local pending=()

  for file in "${generated_files[@]}"; do
    local new_file="${file}.new"
    if [[ ! -f "$new_file" ]]; then
      continue
    fi

    if [[ ! -f "$file" ]]; then
      echo "NEW: $file"
      pending+=("$file")
    elif ! diff -q "$file" "$new_file" >/dev/null 2>&1; then
      echo ""
      echo "=== CHANGED: $file ==="
      diff --color=auto -u "$file" "$new_file" || true
      pending+=("$file")
    else
      rm "$new_file"
    fi
  done

  if [[ ${#pending[@]} -eq 0 ]]; then
    echo "No changes to apply."
    return 0
  fi

  echo ""
  echo "Files to update: ${#pending[@]}"
  read -p "Apply changes? [y/N] " -n 1 -r
  echo ""

  if [[ $REPLY =~ ^[Yy]$ ]]; then
    for file in "${pending[@]}"; do
      mv "${file}.new" "$file"
      echo "Updated: $file"
    done
  else
    for file in "${pending[@]}"; do
      rm "${file}.new"
    done
    echo "Changes discarded."
  fi
}

typeset -A repos
repos=(
  ["$DOT/colors/gruvbox_tmux"]="https://github.com/egel/tmux-gruvbox"
  ["$DOT/colors/gruvbox_kitty"]="https://github.com/michaelorr/kitty_gruvbox_theme"
  ["$DOT/zsh/powerlevel10k"]="https://github.com/romkatv/powerlevel10k"
  ["$DOT/zsh/zsh-vi-mode"]="https://github.com/jeffreytse/zsh-vi-mode"
  ["$DOT/zsh/zsh-defer"]="https://github.com/romkatv/zsh-defer"
  ["$DOT/zsh/fast-syntax-highlighting"]="https://github.com/zdharma-continuum/fast-syntax-highlighting"
  ["$DOT/zsh/fzf-tab"]="https://github.com/Aloxaf/fzf-tab"
  ["$HOME/.tmux/plugins/tpm"]="https://github.com/tmux-plugins/tpm"
)

# If repo is not checked out, check it out. If it is checked out,
# stash any changes, pull, then re-apply changes from stash
for path in "${!repos[@]}"; do
  url=${repos[${path}]}
  name=$(basename "${path}")

  if [[ -d ${path} ]]; then
    start "Updating ${name}"
    changed_files=$(git -C "${path}" status --porcelain --untracked-files=no | wc -l)
    [ "$changed_files" -gt 0 ] && echo "stashing changes" && git -C "${path}" stash
    git -C "${path}" pull
    ([ "$changed_files" -gt 0 ] && git -C "${path}" stash pop) || true
    finished
  else
    start "Installing ${name}"
    git clone "${url}" "${path}"
    finished
  fi
done

if [[ $OS == "darwin" ]]; then
  if [[ $update_brew_packages == "true" ]]; then
    brew update || true
    brew upgrade
  fi

  if [[ $install_brew_packages == "true" ]]; then
    brew install --cask git-credential-manager
    brew tap microsoft/git
    brew install \
      ast-grep \
      actionlint \
      bash \
      bat \
      coreutils \
      difftastic \
      docker \
      docker-completion \
      eza \
      fd \
      fzf \
      git \
      git-delta \
      htop \
      jesseduffield/lazydocker/lazydocker \
      jesseduffield/lazygit/lazygit \
      jq \
      kitty \
      kubecolor/tap/kubecolor \
      kubectl \
      mermaid-cli \
      neovim \
      ripgrep \
      the_silver_searcher \
      tmux \
      trash \
      tree \
      vivid \
      wget \
      zsh-autosuggestions \
      zsh-completions
  fi

  ln_args="-hfs"

  export XDG_CONFIG_HOME=$HOME/.config
  goos="darwin"
  group_name="admin"

  # add `bat` support for php
  # bat is used by git-delta
  mkdir -p "${XDG_CONFIG_HOME}"/bat/syntaxes
  # shellcheck disable=SC2086
  ln $ln_args "${DOT}/git/PHP.sublime-syntax" "${XDG_CONFIG_HOME}/bat/syntaxes/PHP.sublime-syntax"
  # shellcheck disable=SC2086
  ln $ln_args "${DOT}/etc/bat_config" "${XDG_CONFIG_HOME}/bat/config"
  cd && bat cache --build >/dev/null && cd --

  # shellcheck disable=SC2016
  envsubst '${DOT} ${TPL_HEADER}' <"${DOT}/tmux/tmux.conf.tpl" >"${DOT}/tmux/tmux.conf.new"
  register_generated "${DOT}/tmux/tmux.conf"
  # shellcheck disable=SC2086
  ln $ln_args "${DOT}/tmux/tmux.conf" "${HOME}/.tmux.conf" 2>/dev/null || true

  start "Asserting tmux-256color terminfo (kitty-based, correct Smulx/Setulc)"
  if ! infocmp -x tmux-256color 2>/dev/null | grep -q 'Smulx=\\E\[4\\:%p1%dm'; then
    infocmp -x xterm-kitty |
      sed 's/xterm-kitty|KovIdTTY/tmux-256color|tmux with 256 colors/' |
      tic -x -o "${HOME}/.terminfo" -
    echo "Compiled tmux-256color terminfo from xterm-kitty"
  fi
  finished

  export GIT_PAGER="pager = delta"
  export GIT_DELTA="[delta]
  line-numbers = true
  true-color = always
  # side-by-side = true
  hyperlinks = true
  navigate = true
  dark = true
  syntax-theme = gruvbox-dark
  line-numbers-left-format = \"{nm:^3}│\"
  line-numbers-minus-style = \"red bold\"
  line-numbers-plus-style = \"green bold\"
  line-numbers-right-format = \"{np:^3}│\"
  tabs = 4
  plus-style = syntax auto
  minus-style = syntax auto
  zero-style = syntax auto dim
[interactive]
  diffFilter = delta --color-only
[pager]
  diff = delta
  show = delta
  log = delta
  blame = delta
  reflog = delta"
fi

mkdir -p "${XDG_CONFIG_HOME}"/vivid/themes
# shellcheck disable=SC2086
ln $ln_args "${DOT}/colors/vivid/themes/gruvbox-morr.yml" "${XDG_CONFIG_HOME}/vivid/themes/gruvbox-morr.yml"

if [[ ! -d ${GO_INSTALL_PATH}/go ]]; then
  version=$(curl "https://go.dev/VERSION?m=text" | head -n1)
  start "Installing golang version: ${version}"
  # install go if not found on path
  tmp_dir=$(mktemp -d -t golang-XXXXX)
  wget "https://go.dev/dl/${version}.${goos}-${ARCH}.tar.gz" -P "$tmp_dir"
  sudo mkdir "${GO_INSTALL_PATH}/go"
  sudo chown "$USER":"${group_name}" "${GO_INSTALL_PATH}/go"
  tar -xzf "${tmp_dir}"/go1.*.tar.gz -C "${GO_INSTALL_PATH}"
  rm -rf "$tmp_dir"

  go install github.com/nametake/golangci-lint-langserver@latest
  go install golang.org/x/tools/gopls@latest
  finished
fi

if [[ $install_tparse == "true" ]]; then
  start "Installing go utilities"
  go install github.com/mfridman/tparse@latest
  finished
fi

start "Generating git/gitconfig zsh/zshenv zsh/env.d/tmux.env"
templates=("git/gitconfig" "zsh/zshenv" "zsh/env.d/tmux.env")
for tpl in "${templates[@]}"; do
  # shellcheck disable=SC2016
  envsubst '${DEFAULT_EMAIL} ${DOT} ${GIT_PAGER} ${GIT_DELTA} ${TOOLS} ${SRC} ${TMUX_ENABLED} ${XDG_CONFIG_HOME} ${TPL_HEADER}' <"${DOT}/${tpl}.tpl" >"${DOT}/${tpl}.new"
  register_generated "${DOT}/${tpl}"
done
finished

start "Concatting env files"
echo "export LS_COLORS=\"$(vivid generate gruvbox-morr)\"" >>$DOT/zsh/zshenv.new
cat $DOT/zsh/env.d/*.env | grep -v "^#" | grep -v "^$" >>$DOT/zsh/zshenv.new
finished

start "Concatting rc files"
rc_files=(
  "${DOT}/zsh/rc.d/completions.zsh"
  "${DOT}/zsh/rc.d/homebrew-path.zsh"
  "${DOT}/zsh/rc.d/tmux.zsh"
  "${DOT}/zsh/rc.d/p10k.init.zsh"
  "${DOT}/zsh/rc.d/aliases.zsh"
  "${DOT}/zsh/rc.d/base.zsh"
  "${DOT}/zsh/rc.d/colored-man-pages.zsh"
  "${DOT}/zsh/rc.d/history.zsh"
  "${DOT}/zsh/rc.d/funcs.zsh"
  "${DOT}/zsh/rc.d/zle.zsh"
  "${DOT}/zsh/rc.d/tmux-vim-integration.plugin.zsh"
  "${DOT}/zsh/rc.d/zsh-autosuggestions.zsh"
  "${DOT}/zsh/rc.d/fast-syntax-highlighting.zsh"
  "${DOT}/zsh/rc.d/zsh-vi-mode.zsh"
  "${DOT}/zsh/rc.d/fzf.zsh" # must come after zsh-vi-mode for history widget (^r) to work
  "${DOT}/zsh/rc.d/asdf.zsh"
  "${DOT}/zsh/rc.d/p10k.source.zsh"
)
echo "####
# This file is compiled via $DOT/bootstrap
# Do not directly modify it
####" >${zshrc}.new
echo "source ${DOT}/zsh/zsh-defer/zsh-defer.plugin.zsh" >>${zshrc}.new
for f in "${rc_files[@]}"; do
  {
    echo "### ${f}"
    grep -v "^#" "${f}" | grep -v "^$"
    echo
  } >>${zshrc}.new
done
register_generated "${zshrc}"
finished

start "Linking p10k.zsh global config into zsh directory"
# shellcheck disable=SC2086
ln $ln_args "${DOT}/zsh/p10k.zsh" "${HOME}/.p10k.zsh"
finished

start "Linking golangci.yml into /usr/local/src"
mkdir -p "${SRC}"
# shellcheck disable=SC2086
ln $ln_args "${DOT}/etc/golangci.yml" "${SRC}/.golangci.yml"
finished

start "Linking git/gitconfig zsh/zshenv zsh/zshrc etc/hushlogin etc/agignore etc/pspgconf etc/my.cnf"
source_configs=("git/gitconfig" "zsh/zshenv" "zsh/zshrc" "etc/hushlogin" "etc/agignore" "etc/pspgconf" "etc/my.cnf" "etc/myclirc")
for f in "${source_configs[@]}"; do
  # shellcheck disable=SC2086
  ln $ln_args "${DOT}/${f}" "${HOME}/.$(basename "$f")"
done
# shellcheck disable=SC2086
ln "$ln_args" "${DOT}/etc/markdownlint.yaml" "${HOME}/.markdownlint.yaml"
finished

start "Linking kitty.conf"
mkdir -p "${XDG_CONFIG_HOME}"/kitty

# shellcheck disable=SC2016
envsubst '${DOT} ${TPL_HEADER}' < <(cat "${DOT}/etc/kitty.conf.tpl" | grep -v "^#" | grep -v "^$") >"${DOT}/etc/kitty.conf.new"
register_generated "${DOT}/etc/kitty.conf"
# shellcheck disable=SC2086
ln $ln_args "${DOT}/etc/kitty.conf" "${XDG_CONFIG_HOME}/kitty/kitty.conf" 2>/dev/null || true
finished

start "Linking nvim config and data directories"
mkdir -p "${HOME}/.local/share"
# shellcheck disable=SC2086
ln $ln_args "${DOT}/config.nvim" "${XDG_CONFIG_HOME}/nvim"
# shellcheck disable=SC2086
ln $ln_args "${DOT}/local.share.nvim" "${HOME}/.local/share/nvim"
finished

# The claude config is symlinked into place and it references hooks that live in the dotfiles repo.
# The hooks themselves are made immutable via the schg flag to prevent accidental modification.
# Symlinks cannot have flags set on them, which is why we don't symlink the hooks themselves.
start "Linking Claude configs"
mkdir -p "${HOME}/.claude"
# shellcheck disable=SC2086
ln $ln_args "${DOT}/etc/claude/settings.json" "${HOME}/.claude/settings.json"
# shellcheck disable=SC2086
ln $ln_args "${DOT}/etc/claude/CLAUDE.md" "${HOME}/.claude/CLAUDE.md"
for hook_file in "${DOT}/etc/claude/hooks/"*; do
  if [[ -f "$hook_file" ]]; then
    if [[ "$(stat -f %Sf "$hook_file")" != *"schg"* ]]; then
      echo "Set schg flag on $(basename "$hook_file")"
      sudo chflags schg "$hook_file"
    fi
  fi
done
finished

# Opencode plugin configs are copied into place and made immutable via the schg flag.
# Symlinks cannot have flags set on them.
start "Linking opencode configs"
mkdir -p "${HOME}/.config/opencode/plugins"
for plugin_file in "${DOT}/etc/opencode/plugins/"*; do
  if [[ -f "$plugin_file" ]]; then
    dest_file="${HOME}/.config/opencode/plugins/$(basename "$plugin_file")"

    # The destination file either doesn't exist or differs from the source file
    # -- copy it and set the schg flag
    if [[ ! -f "$dest_file" ]] || ! cmp -s "$plugin_file" "$dest_file"; then
      [[ -f "$dest_file" ]] && sudo chflags noschg "$dest_file"
      cp -f "$plugin_file" "$dest_file"
      sudo chflags schg "$dest_file"
    fi
  fi
done
finished

if [[ $install_google_cloud_sdk == "true" ]]; then
  if [[ ! -d ${TOOLS}/google-cloud-sdk ]]; then
    start "Installing gcloud/kubectl"
    tmp_dir=$(mktemp -d -t gcloud-XXXXX)
    curl https://sdk.cloud.google.com >"$tmp_dir/install_gcloud.sh"
    bash "$tmp_dir/install_gcloud.sh" --disable-prompts --install-dir=${TOOLS}
    rm -rf "$tmp_dir"
    ${TOOLS}/google-cloud-sdk/bin/gcloud components install kubectl --quiet
    finished
  fi

  if [[ -f $TOOLS/google-cloud-sdk/path.zsh.inc ]]; then
    echo "### $TOOLS/google-cloud-sdk/path.zsh.inc
        source $TOOLS/google-cloud-sdk/path.zsh.inc" >>${zshrc}.new
  fi

  if [ -f $TOOLS/google-cloud-sdk/completion.zsh.inc ]; then
    echo "### $TOOLS/google-cloud-sdk/completion.zsh.inc" >>${zshrc}.new
    cat "$TOOLS/google-cloud-sdk/completion.zsh.inc" >>${zshrc}.new
  fi
fi

start "Reviewing generated files"
review_and_apply
finished

missing_lsp=()
command -v gopls >/dev/null || missing_lsp+=("gopls (go install golang.org/x/tools/gopls@latest)")
command -v golangci-lint-langserver >/dev/null || missing_lsp+=("golangci-lint-langserver (go install github.com/nametake/golangci-lint-langserver@latest)")
command -v ruby-lsp >/dev/null || missing_lsp+=("ruby-lsp (gem install ruby-lsp)")

if [[ ${#missing_lsp[@]} -gt 0 ]]; then
  echo "================================================"
  echo "Missing LSP servers:"
  for lsp in "${missing_lsp[@]}"; do
    echo "  - $lsp"
  done
  echo "================================================="
fi
